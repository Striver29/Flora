# Copy to apps/mobile/.env and adjust:  cp apps/mobile/.env.example apps/mobile/.env
#
# Expo reads .env from THIS directory (the Expo project root), NOT the repo root.
# A var placed in the repo-root .env will not reach the app.
#
# Everything here ships inside the app bundle: EXPO_PUBLIC_* values are inlined
# at build time and readable by anyone with the app. Never put a secret here —
# API keys belong in the repo-root .env, which only apps/api reads.

# Which data client the app uses: 'mock' (default) or 'live'.
# Only diagnoses exist on the API today, so 'live' breaks the rest of the app.
EXPO_PUBLIC_API_MODE=mock

# 1 = run the Plant.id scan against the real API while everything else stays on
# the offline mock. 0 (default) = fully offline, the mode the mentor demo needs.
EXPO_PUBLIC_LIVE_SCAN=0

# API base URL as seen FROM THE PHONE. Blank auto-derives the LAN address from
# the Metro host (correct for Expo Go). Never localhost on a physical device —
# that resolves to the phone itself.
EXPO_PUBLIC_API_URL=
