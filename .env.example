# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is gitignored and must never be committed. Each teammate keeps their own.

# Local Postgres (docker compose up -d db)
DATABASE_URL=postgresql://flora:flora@localhost:5432/flora

# NOTE: mobile settings do NOT live here. Expo loads .env from its own project
# root, so every EXPO_PUBLIC_* var belongs in apps/mobile/.env — see
# apps/mobile/.env.example. A copy placed in this file is silently ignored.

# --- apps/api ---------------------------------------------------------------
# Port the API listens on.
PORT=4000

# Plant.id recognition key. Get your own (free tier) at https://web.plant.id —
# per-developer keys keep quotas separate. NEVER prefix this EXPO_PUBLIC_: that
# would inline it into the mobile bundle and publish it.
# Leave blank to use the fixture-backed stub recognizer — no key, no network.
PLANT_ID_API_KEY=

# Plant.id API root. Override to point at a mock server.
PLANT_ID_BASE_URL=https://plant.id/api/v3

# Give up on a recognition call after this long. Mobile stops polling at 90s.
FLORA_RECOGNITION_TIMEOUT_MS=45000

# Largest accepted image, in bytes, decoded. Temporary: images stop crossing the
# API once the S3 upload path lands.
FLORA_MAX_IMAGE_BYTES=6291456

# Which canned response the stub replays: healthy-basil | diseased-tomato | blurry
FLORA_STUB_FIXTURE=healthy-basil

# --- apps/api: Bedrock LLM ---------------------------------------------------
# Care advice and drafted community posts are written by an OpenAI gpt-oss model
# on Amazon Bedrock. Set to 1 to make real calls; anything else replays fixtures
# from test/fixtures/llm-*.json — no AWS account, no model access, no spend.
# Credentials come from the standard AWS chain, so there is no key to set here.
# Verify a real call with: FLORA_LLM_ENABLED=1 pnpm -F api smoke:bedrock
FLORA_LLM_ENABLED=

# Region the Bedrock calls go to. Model access must be requested per-region in
# the Bedrock console first. gpt-oss is in-region only — there is no global or
# geo cross-region endpoint, so this must name a region that hosts the model
# (us-east-1, us-east-2, us-west-2, eu-west-1, eu-central-1 and others).
FLORA_BEDROCK_REGION=us-east-1

# Bedrock model id. openai.gpt-oss-20b-1:0 is the smaller, cheaper, faster
# sibling — worth trying if advice quality holds up.
FLORA_BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# Give up on one model call after this long.
FLORA_LLM_TIMEOUT_MS=30000
